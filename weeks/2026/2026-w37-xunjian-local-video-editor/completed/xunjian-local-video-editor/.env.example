KIE_API_KEY=replace_with_your_kie_ai_api_key
KIE_API_BASE_URL=https://api.kie.ai

# Optional local video tool overrides. Use these when tools are installed but not on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# WHISPERX_PATH=C:\path\to\xunjian-local-video-editor\.venv\Scripts\whisperx.exe
# YT_DLP_PATH=C:\path\to\Python\Scripts\yt-dlp.exe
# AGENT_VIDEO_TOOL_DIRS=C:\ffmpeg\bin;C:\path\to\Python\Scripts
